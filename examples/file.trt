// Tag: @type @enum(
//     Allocated;
//     Free;
// );
// Node: @type @var(Tag)(
//     Allocated: @rec(
//         mem0: s32;
//         mem1: u32;
//     );
//     Free: @rec(
//         mem1: s32;
//     );
// );

allocator: @type @rec(
    ctx: opaque;

    alloc: opaque;
    aligned_alloc: opaque;
    free: opaque;
    realloc: opaque;
);
cmalloc: @fn(size: usize) opaque = @external "malloc";
caligned_alloc: @fn(alignment: usize; size: usize) opaque = @external "aligned_alloc";
cfree: @fn(ptr: opaque) void = @external "free";

arena: @type @rec(
    capacity: usize;
    length: usize;
    data: opaque;
);
arena_init: @fn(capacity: s32) arena = (
    length: s32 = 0;
    data: opaque = caligned_alloc(capacity);
    @(arena)(capacity; length; data);
);
arena_deinit: @fn(self: imut * arena) void =
    cfree(self::data);

// arena_alloc: @fn(self: imut * arena; size: usize; align: usize) opaque = (
//     case (self::length+ size < self::capacity) (
//         true => (
//         );
//     )
// );

arena_len: @fn(a: imut*imut arena) usize = a::length;
arena_is_full: @fn(a: imut*imut arena) usize = a::length and a::capacity;

B: @type @rec(
    mem0: s32;
    mem1: C;
);

b: B = @(B)(0; @(C)(0));
c: D = b::mem1::mem0;

A: @type @rec(
  mem0: C;
  mem1: s32;
);

C: @type @rec(mem0: f32);
D: @type C;

