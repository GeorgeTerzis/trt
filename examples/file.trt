// a simple dynamic array arena
// arena: @type @rec(
//     capacity: usize;
//     length: usize;
//     data: opaque;
// );


// arena_init: @fn(capacity: s32) arena = (
//     // length: s32 = 0;
//     // data: opaque = cmalloc(capacity);
//     ret @(arena)(capacity; length; data);
// );

// arena_new: @fn(capacity: usize) arena = arena_init(capacity);
// arena_alloc: @fn(a: *arena; size: usize; align: usize) opaque = arena_alloc_impl(a; size; align);
// arena_len: @fn(a: *arena) usize = a::length;
// arena_is_full: @fn(a: *arena) usize = a::length and a::capacity;

B: @type @rec(
    mem0: s32;
    mem1: C;
);

A: @type @rec(
  mem0: C;
  mem1: s32;
);

C: @type @rec(
    mem0: f32
);

D: @type C;

b: B = 0;
c: D = b::mem1::mem0;
